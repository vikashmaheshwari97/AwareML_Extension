{
  "schema_version": "phase15_hpc_empirical_protocol_v1",
  "status": "predeclared_before_final_hpc_results",
  "purpose": "final 24-case empirical LLM explanation correctness and faithfulness evaluation",
  "case_design": {
    "controlled_case_source": "awareml.explanation_integrity.controlled.build_controlled_cases",
    "expected_case_count": 24,
    "contexts": 6,
    "sources_per_context": 4,
    "source_order": [
      "B",
      "E",
      "F_XAI",
      "F_CHAT"
    ],
    "one_original_generation_per_case": true,
    "one_relevant_counterfactual_generation_per_case": true
  },
  "model_lock": {
    "model": "llama3:8b",
    "model_digest": "365c0bd3c000a25d28ddbf732fe1c6add414de7275464c4e4d1c3b5fcb5d8ad1",
    "ollama_version": "0.32.14",
    "strict_model_digest": true,
    "strict_ollama_version": true
  },
  "generation_lock": {
    "prompt_version": "phase15_explanation_prompt_v4",
    "temperature": 0.0,
    "top_p": 1.0,
    "seed": 42,
    "num_predict": 512,
    "stream": false
  },
  "runtime": {
    "per_generation_timeout_sec": 300,
    "retries": 1,
    "fail_fast_within_case": false,
    "array_tasks": 24,
    "default_array_concurrency": 4,
    "default_partition": "gpu",
    "default_gpu_gres": "gpu:a100-40g:1",
    "default_cpus_per_task": 4,
    "default_memory": "16G",
    "default_time_limit": "01:00:00"
  },
  "output_policy": {
    "raw_root": "artifacts/phase15/hpc_runs/<campaign_id>",
    "per_case_attempts_are_append_only": true,
    "success_marker_required": true,
    "failed_attempts_preserved": true,
    "resume_skips_successful_cases": true,
    "reducer_requires_24_successes_by_default": true,
    "results_are_not_auto_frozen": true
  },
  "scientific_separation": {
    "controlled_methodology_artifacts_unchanged": true,
    "live_dataset_probe_not_used_as_empirical_evidence": true,
    "final_hpc_results_must_be_reviewed_before_journal_claim": true,
    "no_posthoc_tuning_after_final_campaign_results": true
  }
}
