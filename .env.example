# AwareML Extension local configuration
OLLAMA_BASE_URL=http://localhost:11434
# This is only a fallback default. The UI discovers models installed in Ollama.
OLLAMA_MODEL=llama3.1:8b
AWAREML_COUNTRY_ISO=EST
AWAREML_STUDY_DB=artifacts/awareml_studies.sqlite3

# run.ps1 sets these automatically when the environments exist.
AWAREML_OAML_PYTHON=.venv-oaml/Scripts/python.exe
AWAREML_EVO_PYTHON=.venv-evo/Scripts/python.exe

# OAML can run its River 0.8 streaming path or a GAMA warm-up/refit bridge.
AWAREML_OAML_MODE=online
AWAREML_OAML_GAMA_BUDGET=5
AWAREML_OAML_GAMA_WARMUP=50
AWAREML_OAML_GAMA_REFIT=500
